{
  "expo": {
    "name": "Rwear App",
    "slug": "rwear-app",
    "version": "1.0.9",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rwear.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "react-native-google-cast",
      "expo-router",
      "expo-video",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Rwear to access motion & fitness data for step counting and activity tracking."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "768bf314-3231-4f48-ac91-e4afb1acc830"
      }
    }
  }
}
