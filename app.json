{
  "expo": {
    "name": "Rwear App",
    "slug": "rwear-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./front/assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./front/assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./front/assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rwear.app"
    },
    "web": {
      "favicon": "./front/assets/images/favicon.png"
    },
    "plugins": [
      "react-native-google-cast",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.22",
            "gradlePluginVersion": "8.4.1"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "768bf314-3231-4f48-ac91-e4afb1acc830"
      }
    }
  }
}