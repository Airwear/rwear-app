{
  "expo": {
    "name": "Rwear App",
    "slug": "rwear-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./front/assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./front/assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./front/assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rwear.app"
    },
    "web": {
      "favicon": "./front/assets/images/favicon.png"
    },
    "plugins": [
      "react-native-google-cast"
    ]
  }
}