{
  "expo": {
    "name": "Rwear",
    "slug": "rwear-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.airwear.rwear",
      "infoPlist": {
        "NSCameraUsageDescription": "Cette app nécessite l'accès à la caméra pour certaines fonctionnalités.",
        "NSMicrophoneUsageDescription": "Cette app nécessite l'accès au microphone pour certaines fonctionnalités.",
        "NSPhotoLibraryUsageDescription": "Cette app nécessite l'accès à vos photos."
      }
    },
    "android": {
      "package": "com.airwear.rwear",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Permet l'enregistrement audio pour les fonctionnalités de l'app."
        }
      ],
      "expo-video"
    ],
    "scheme": "rwear",
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    },
    "owner": "airwear"
  }
}
