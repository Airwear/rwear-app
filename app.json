{
  "expo": {
    "name": "Rwear",
    "slug": "rwear-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./front/assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./front/assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.airwear.rwear",
      "infoPlist": {
        "NSCameraUsageDescription": "Cette app nécessite l'accès à la caméra pour certaines fonctionnalités.",
        "NSMicrophoneUsageDescription": "Cette app nécessite l'accès au microphone pour certaines fonctionnalités.",
        "NSPhotoLibraryUsageDescription": "Cette app nécessite l'accès à vos photos.",
        "NSBonjourServices": [
          "_googlecast._tcp",
          "_CC1AD845._googlecast._tcp"
        ],
        "NSLocalNetworkUsageDescription": "Cette app utilise le réseau local pour détecter les appareils Cast sur votre réseau WiFi."
      }
    },
    "android": {
      "package": "com.airwear.rwear",
      "googleServicesFile": "./android/app/google-services.json",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./front/assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE"
      ]
    },
    "web": {
      "favicon": "./front/assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      "expo-web-browser",
      [
        "react-native-google-cast",
        {
          "androidReceiverAppId": "CC1AD845",
          "iosReceiverAppId": "CC1AD845"
        }
      ],
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "768bf314-3231-4f48-ac91-e4afb1acc830"
      }
    },
    "owner": "12345dom",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/768bf314-3231-4f48-ac91-e4afb1acc830"
    }
  }
}