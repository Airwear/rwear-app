+  @ReactMethod(isBlockingSynchronousMethod = true)
+  fun install(): Boolean {
+    return try {
+      SoLoader.loadLibrary("gesturehandler")
+      val jsContext = reactApplicationContext.javaScriptContextHolder
+      // javaScriptContextHolder is nullable on some RN versions/configurations.
+      // Use a safe call and only call native decorateRuntime when we have a non-null pointer.
+      val jsiPtr = jsContext?.get()
+      if (jsiPtr != null) {
+        decorateRuntime(jsiPtr)
+        true
+      } else {
+        // If no JS context is available, skip JSI bindings installation.
+        Log.w("[RNGestureHandler]", "JS context not available, skipping JSI bindings installation.")
+        false
+      }
+    } catch (exception: Exception) {
+      Log.w("[RNGestureHandler]", "Could not install JSI bindings.")
+      false
+    }
+  }
